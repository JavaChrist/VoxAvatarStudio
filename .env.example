# Copy to .env.local and fill in. Never commit .env.local.
# All keys are server-only: never prefix a secret with NEXT_PUBLIC_.

# fal.ai (Kling AI Avatar v2 Pro)
FAL_KEY=

# ElevenLabs (voice from the library)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Anthropic (scripts) - used from the app step onwards
ANTHROPIC_API_KEY=

# Firebase web config (Console > Project settings > Your apps > VoxAvatarStudio-web).
# These are public by design: access is protected by Firestore/Storage Security Rules and Auth.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=voxavatarstudio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=voxavatarstudio
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=voxavatarstudio.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1082227362763
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only, SECRET). From a service account key
# (Console > Project settings > Service accounts > Generate new private key).
# Copy the three fields from the JSON; never commit the JSON file itself.
FIREBASE_ADMIN_PROJECT_ID=voxavatarstudio
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Login allowlist (server only): comma-separated emails allowed to sign in.
ALLOWED_EMAILS=

# GitHub (server only, SECRET): fine-grained token limited to this repository,
# permission Actions: Read and write. Used to start the render workflow and follow its run.
GITHUB_RENDER_TOKEN=

# Machine access (server only, SECRET, optional): lets a tool such as the MCP connector call /api/*
# with "Authorization: Bearer <VOX_API_TOKEN>" on behalf of the Firebase user VOX_API_UID (must be in ALLOWED_EMAILS).
# Leave VOX_API_TOKEN empty to turn it off. At least 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VOX_API_TOKEN=
VOX_API_UID=
